{
  "name": "trendbridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @trendbridge/api dev",
    "dev:workers": "pnpm --filter @trendbridge/workers dev",
    "dev:web": "pnpm --filter @trendbridge/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @trendbridge/api db:migrate",
    "db:seed": "pnpm --filter @trendbridge/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5",
    "@vitest/coverage-v8": "^2.1.5",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
