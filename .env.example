# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trendbridge
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
ANALYTICS_URL=http://localhost:8000

# --- Auth (single admin, sample credentials; change before exposing anywhere) ---
ADMIN_EMAIL=admin@trendbridge.local
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-to-a-long-random-string

# --- Budget guards (Rs 0 rule) ---
LLM_ENABLED=false
LLM_DAILY_TOKEN_CAP=0
ANTHROPIC_API_KEY=

# --- Optional free API keys (connectors run in fixture mode without them) ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ETSY_API_KEY=
PRODUCTHUNT_TOKEN=
GNEWS_API_KEY=

# --- Fetching ---
LIVE_FETCH_ENABLED=true
FETCH_USER_AGENT=TrendBridge/0.1 (personal research tool; polite fetcher)

# --- Weekly report email (optional; your own SMTP, e.g. a Gmail app password). Without these the report is download-only. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_TO=
