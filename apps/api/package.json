{
  "name": "@trendbridge/api",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @trendbridge/db migrate",
    "db:seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@trendbridge/db": "workspace:*",
    "@trendbridge/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "pdfkit": "^0.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.7"
  }
}
